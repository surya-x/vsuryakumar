---
import { SOCIAL_LINKS } from '../consts';
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<div class="footer-top">
			<div class="footer-brand">
				<a href="/" class="footer-logo">
					<span class="logo-icon">V</span>
					<span>V Surya Kumar</span>
				</a>
				<p class="footer-tagline">Writing about AI, Software Engineering &amp; Systems.</p>
			</div>
			<div class="footer-links">
				<div class="footer-col">
					<h4>Navigate</h4>
					<a href="/">Home</a>
					<a href="/blog">Blog</a>
					<a href="/tags">Tags</a>
					<a href="/about">About</a>
				</div>
				<div class="footer-col">
					<h4>Connect</h4>
					<a href={SOCIAL_LINKS.github} target="_blank" rel="noopener">GitHub</a>
					<a href={SOCIAL_LINKS.x} target="_blank" rel="noopener">X (Twitter)</a>
					<a href="/rss.xml">RSS Feed</a>
				</div>
			</div>
		</div>
		<div class="footer-bottom">
			<p>&copy; {today.getFullYear()} V Surya Kumar. All rights reserved.</p>
		</div>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
		background: var(--bg-secondary);
		margin-top: 4em;
	}
	.footer-inner {
		max-width: 1100px;
		margin: 0 auto;
		padding: 3em 1.5em 2em;
	}
	.footer-top {
		display: flex;
		justify-content: space-between;
		gap: 3em;
		margin-bottom: 2.5em;
	}
	.footer-brand {
		max-width: 320px;
	}
	.footer-logo {
		display: flex;
		align-items: center;
		gap: 0.6em;
		text-decoration: none;
		color: var(--text-primary);
		font-weight: 700;
		font-size: 1.05em;
		margin-bottom: 0.75em;
	}
	.footer-logo:hover {
		color: var(--text-primary);
	}
	.logo-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		border-radius: 7px;
		background: var(--gradient-text);
		color: #fff;
		font-weight: 800;
		font-size: 0.85em;
	}
	.footer-tagline {
		color: var(--text-muted);
		font-size: 0.9em;
		margin: 0;
		line-height: 1.5;
	}
	.footer-links {
		display: flex;
		gap: 4em;
	}
	.footer-col {
		display: flex;
		flex-direction: column;
		gap: 0.5em;
	}
	.footer-col h4 {
		font-size: 0.8em;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-muted);
		margin-bottom: 0.25em;
	}
	.footer-col a {
		color: var(--text-secondary);
		text-decoration: none;
		font-size: 0.9em;
		transition: var(--transition);
	}
	.footer-col a:hover {
		color: var(--accent);
	}
	.footer-bottom {
		border-top: 1px solid var(--border);
		padding-top: 1.5em;
	}
	.footer-bottom p {
		color: var(--text-muted);
		font-size: 0.82em;
		margin: 0;
		text-align: center;
	}
	@media (max-width: 720px) {
		.footer-top {
			flex-direction: column;
			gap: 2em;
		}
		.footer-links {
			gap: 2.5em;
		}
	}
</style>
