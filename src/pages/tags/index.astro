---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import TagBadge from '../../components/TagBadge.astro';
import { SITE_TITLE } from '../../consts';

const posts = await getCollection('blog');
const tagMap = new Map<string, number>();
posts.forEach((post) => {
	(post.data.tags || []).forEach((tag: string) => {
		tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
	});
});
const tags = [...tagMap.entries()].sort((a, b) => b[1] - a[1]);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Tags — ${SITE_TITLE}`} description="Browse all topics" />
	</head>
	<body>
		<Header />
		<main>
			<section class="tags-header">
				<h1>Tags</h1>
				<p class="tags-desc">Browse posts by topic.</p>
			</section>
			<section class="tags-grid">
				{tags.map(([tag, count]) => (
					<a href={`/tags/${tag}`} class="tag-card">
						<span class="tag-name"><TagBadge tag={tag} size="md" linked={false} /></span>
						<span class="tag-count">{count} {count === 1 ? 'post' : 'posts'}</span>
					</a>
				))}
			</section>
		</main>
		<Footer />
		<style>
			.tags-header { padding: 2em 0 2.5em; border-bottom: 1px solid var(--border); margin-bottom: 2em; }
			.tags-header h1 { font-size: 2.25em; margin-bottom: 0.35em; }
			.tags-desc { color: var(--text-muted); font-size: 1.05em; }
			.tags-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1em; }
			.tag-card {
				display: flex; align-items: center; justify-content: space-between; gap: 1em;
				padding: 1.25em 1.5em; border-radius: var(--radius-lg); border: 1px solid var(--border);
				background: var(--bg-card); text-decoration: none; transition: var(--transition); overflow: hidden;
			}
			.tag-count { white-space: nowrap; }
			.tag-card:hover { border-color: var(--border-hover); transform: translateY(-2px); box-shadow: var(--shadow-glow); }
			.tag-count { color: var(--text-muted); font-size: 0.82em; font-family: var(--font-jetbrains); }
		</style>
	</body>
</html>
