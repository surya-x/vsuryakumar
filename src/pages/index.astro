---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import TagBadge from '../components/TagBadge.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latestPosts = posts.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<!-- Hero Section -->
		<section class="hero">
			<div class="hero-bg"></div>
			<div class="hero-content">
				<p class="hero-greeting">Hi, I'm</p>
				<h1 class="hero-name">
					<span class="gradient-text">V Surya Kumar</span>
				</h1>
				<p class="hero-tagline">Software Engineer · AI Enthusiast · Systems Thinker</p>
				<p class="hero-description">
					I write about artificial intelligence, software engineering, and systems design.
					Currently building at <strong>Goldman Sachs</strong>.
				</p>
				<div class="hero-cta">
					<a href="/blog" class="btn btn-primary">Read the Blog</a>
					<a href="/about" class="btn btn-secondary">About Me</a>
				</div>
			</div>
		</section>

		<!-- Latest Posts -->
		<main>
			<section class="latest-posts">
				<div class="section-header">
					<h2>Latest Posts</h2>
					<a href="/blog" class="view-all">View all &rarr;</a>
				</div>
				<div class="posts-grid">
					{latestPosts.map((post) => (
						<a href={`/blog/${post.id}/`} class="post-card" id={`post-${post.id}`}>
							<div class="post-card-inner">
								<div class="post-meta">
									<span class="post-date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</div>
								<h3 class="post-title">{post.data.title}</h3>
								<p class="post-description">{post.data.description}</p>
								{post.data.tags && post.data.tags.length > 0 && (
									<div class="post-tags">
										{post.data.tags.map((tag: string) => (
											<TagBadge tag={tag} linked={false} />
										))}
									</div>
								)}
							</div>
						</a>
					))}
				</div>
			</section>
		</main>

		<Footer />

		<style>
			/* Hero */
			.hero {
				position: relative;
				padding: 6em 1.5em 5em;
				text-align: center;
				overflow: hidden;
			}
			.hero-bg {
				position: absolute;
				inset: 0;
				background-image: radial-gradient(circle at 1px 1px, rgba(255, 255, 255, 0.03) 1px, transparent 0);
				background-size: 32px 32px;
				pointer-events: none;
			}
			.hero-bg::after {
				content: '';
				position: absolute;
				bottom: 0;
				left: 0;
				right: 0;
				height: 120px;
				background: linear-gradient(to top, var(--bg-primary), transparent);
			}
			.hero-content {
				position: relative;
				max-width: 700px;
				margin: 0 auto;
			}
			.hero-greeting {
				color: var(--accent);
				font-family: var(--font-jetbrains);
				font-size: 0.95em;
				margin-bottom: 0.5em;
				letter-spacing: 0.02em;
			}
			.hero-name {
				font-size: 4em;
				font-weight: 800;
				letter-spacing: -0.04em;
				margin-bottom: 0.3em;
				line-height: 1.1;
			}
			.hero-tagline {
				color: var(--text-muted);
				font-size: 1.1em;
				margin-bottom: 1em;
				font-family: var(--font-jetbrains);
				font-size: 0.9em;
			}
			.hero-description {
				color: var(--text-secondary);
				font-size: 1.1em;
				line-height: 1.7;
				margin-bottom: 2em;
				max-width: 540px;
				margin-left: auto;
				margin-right: auto;
			}
			.hero-description strong {
				color: var(--text-primary);
			}
			.hero-cta {
				display: flex;
				gap: 1em;
				justify-content: center;
				flex-wrap: wrap;
			}
			.btn {
				display: inline-flex;
				align-items: center;
				padding: 0.7em 1.6em;
				border-radius: var(--radius-md);
				font-weight: 600;
				font-size: 0.92em;
				text-decoration: none;
				transition: var(--transition);
			}
			.btn-primary {
				background: var(--gradient-text);
				color: #fff;
			}
			.btn-primary:hover {
				transform: translateY(-2px);
				box-shadow: 0 6px 20px rgba(6, 182, 212, 0.25);
				color: #fff;
			}
			.btn-secondary {
				background: transparent;
				color: var(--text-secondary);
				border: 1px solid var(--border-hover);
			}
			.btn-secondary:hover {
				color: var(--text-primary);
				border-color: var(--accent);
				background: var(--accent-glow);
				transform: translateY(-2px);
			}

			/* Latest Posts */
			.latest-posts {
				padding: 2em 0 3em;
			}
			.section-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 2em;
			}
			.section-header h2 {
				font-size: 1.5em;
				margin: 0;
			}
			.view-all {
				color: var(--text-muted);
				font-size: 0.9em;
				text-decoration: none;
				transition: var(--transition);
			}
			.view-all:hover {
				color: var(--accent);
			}
			.posts-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
				gap: 1.25em;
			}
			.post-card {
				display: block;
				text-decoration: none;
				border-radius: var(--radius-lg);
				border: 1px solid var(--border);
				background: var(--bg-card);
				transition: var(--transition-slow);
				overflow: hidden;
			}
			.post-card:hover {
				border-color: var(--border-hover);
				transform: translateY(-4px);
				box-shadow: var(--shadow-glow);
				background: var(--gradient-card-hover);
			}
			.post-card-inner {
				padding: 1.5em;
			}
			.post-meta {
				margin-bottom: 0.75em;
			}
			.post-date {
				color: var(--text-muted);
				font-size: 0.82em;
				font-family: var(--font-jetbrains);
			}
			.post-title {
				color: var(--text-primary);
				font-size: 1.15em;
				margin: 0 0 0.5em;
				line-height: 1.35;
			}
			.post-description {
				color: var(--text-secondary);
				font-size: 0.9em;
				margin: 0 0 1em;
				line-height: 1.55;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.post-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.35em;
			}

			@media (max-width: 720px) {
				.hero {
					padding: 4em 1em 3em;
				}
				.hero-name {
					font-size: 2.5em;
				}
				.posts-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</body>
</html>
