---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SOCIAL_LINKS } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="About — V Surya Kumar" description="Software Development Associate at Goldman Sachs. Writing about AI, Software Engineering, and Systems." />
	</head>
	<body>
		<Header />
		<main class="about-page">
			<section class="about-hero">
				<p class="about-label">About</p>
				<h1>Hey, I'm <span class="gradient-text">V Surya Kumar</span></h1>
				<p class="about-lead">
					Software Development Associate at <strong>Goldman Sachs</strong>.
					I'm passionate about building software at the intersection of
					AI, distributed systems, and thoughtful engineering.
				</p>
			</section>

			<section class="about-body">
				<div class="about-section">
					<h2>What I Do</h2>
					<p>
						By day, I build software systems at Goldman Sachs. Outside of work,
						I dive deep into AI research, experiment with large language models,
						build autonomous agents, and explore the low-level internals of
						the systems that power modern computing.
					</p>
					<p>
						This blog is where I document what I learn — breaking down complex
						topics in AI, software engineering, and systems design into
						clear, practical writing with real code.
					</p>
				</div>

				<div class="about-section">
					<h2>What I Write About</h2>
					<div class="topics-grid">
						<div class="topic-card">
							<div class="topic-icon">🤖</div>
							<h3>AI & Machine Learning</h3>
							<p>LLMs, agents, inference engines, training pipelines, and everything in between.</p>
						</div>
						<div class="topic-card">
							<div class="topic-icon">⚙️</div>
							<h3>Software Engineering</h3>
							<p>Architecture decisions, code quality, developer tools, and building things that last.</p>
						</div>
						<div class="topic-card">
							<div class="topic-icon">🔧</div>
							<h3>Systems Design</h3>
							<p>Distributed systems, infrastructure, performance, and how things work under the hood.</p>
						</div>
					</div>
				</div>

				<div class="about-section">
					<h2>Get in Touch</h2>
					<p>
						I'm always happy to connect. You can find me on
						<a href={SOCIAL_LINKS.x} target="_blank" rel="noopener">X (Twitter)</a> and
						<a href={SOCIAL_LINKS.github} target="_blank" rel="noopener">GitHub</a>,
						or subscribe to the <a href="/rss.xml">RSS feed</a> to stay updated.
					</p>
				</div>
			</section>
		</main>
		<Footer />

		<style>
			.about-page {
				max-width: 720px;
			}
			.about-hero {
				padding: 2em 0 3em;
				border-bottom: 1px solid var(--border);
				margin-bottom: 3em;
			}
			.about-label {
				color: var(--accent);
				font-family: var(--font-jetbrains);
				font-size: 0.88em;
				margin-bottom: 0.75em;
				letter-spacing: 0.02em;
			}
			.about-hero h1 {
				font-size: 2.5em;
				margin-bottom: 0.75em;
				letter-spacing: -0.03em;
			}
			.about-lead {
				font-size: 1.15em;
				color: var(--text-secondary);
				line-height: 1.75;
				max-width: 600px;
			}
			.about-lead strong {
				color: var(--text-primary);
			}
			.about-section {
				margin-bottom: 3em;
			}
			.about-section h2 {
				font-size: 1.35em;
				margin-bottom: 1em;
			}
			.about-section p {
				color: var(--text-secondary);
				line-height: 1.8;
			}

			.topics-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
				gap: 1em;
				margin-top: 1em;
			}
			.topic-card {
				padding: 1.5em;
				border-radius: var(--radius-lg);
				border: 1px solid var(--border);
				background: var(--bg-card);
				transition: var(--transition);
			}
			.topic-card:hover {
				border-color: var(--border-hover);
				background: var(--gradient-card-hover);
			}
			.topic-icon {
				font-size: 1.75em;
				margin-bottom: 0.5em;
			}
			.topic-card h3 {
				font-size: 1em;
				margin-bottom: 0.5em;
			}
			.topic-card p {
				font-size: 0.88em;
				color: var(--text-muted);
				margin: 0;
				line-height: 1.55;
			}

			@media (max-width: 720px) {
				.about-hero h1 {
					font-size: 1.75em;
				}
				.topics-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</body>
</html>
